The launcher multiplies per-connection limits into uint64_t per-user limits.
Accounting uses unsigned int, so oversized session defaults must saturate
rather than wrap (100000000000000 bytes otherwise becomes 276447232).

diff --git a/src/broker/broker.c b/src/broker/broker.c
--- a/src/broker/broker.c
+++ b/src/broker/broker.c
@@ -5,4 +5,5 @@
 #include <c-list.h>
 #include <c-stdaux.h>
+#include <limits.h>
 #include <signal.h>
 #include <stdlib.h>
@@ -66 +67,5 @@
-        r = bus_init(&broker->bus, broker->log, machine_id, max_bytes, max_fds, max_matches, max_objects);
+        r = bus_init(&broker->bus, broker->log, machine_id,
+                     c_min(max_bytes, (uint64_t)UINT_MAX),
+                     c_min(max_fds, (uint64_t)UINT_MAX),
+                     c_min(max_matches, (uint64_t)UINT_MAX),
+                     c_min(max_objects, (uint64_t)UINT_MAX));
