+-- Dynamic inputs name outputs of derivation-producing materializers. Their
+-- eventual child paths are unknown here; retain the materializer dependencies
+-- and let Nix's subsequent build events discover the generated derivations.
+parseDerivationForGraph :: Parser (Nix.Derivation FilePath Text)
+parseDerivationForGraph = Nix.parseDerivation <|> do
+  dynamic <- False <$ string "Derive(" <|> True <$ string "DrvWithVersion(\"xp-dyn-drv\","
+  outputs <- mapping do
+    _ <- char '('
+    key <- text <* char ','
+    path <- outputPath <* char ','
+    algo <- text <* char ','
+    hash <- text <* char ')'
+    pure (key, Nix.DerivationOutput path algo hash)
+  _ <- char ','
+  inputDrvs <- mapping do
+    _ <- char '('
+    path <- absolutePath <* char ','
+    names <- if dynamic then dynamicOutputs else namesOnly
+    _ <- char ')'
+    pure (path, names)
+  _ <- char ','
+  inputSrcs <- Set.fromList <$> list absolutePath
+  _ <- char ','
+  platform <- text <* char ','
+  builder <- text <* char ','
+  args <- fromList <$> list text
+  _ <- char ','
+  env <- mapping (pair text text)
+  _ <- char ')'
+  pure $ Nix.Derivation outputs inputDrvs inputSrcs platform builder args env
+ where
+  text = Nix.textParser
+  list item = char '[' *> sepBy item (char ',') <* char ']'
+  mapping item = fromList <$> list item
+  pair key value = (,) <$> (char '(' *> key <* char ',') <*> (value <* char ')')
+  absolutePath = do
+    path <- text
+    guard $ Text.isPrefixOf "/" path
+    pure $ toString path
+  outputPath = ("" <$ string "\"\"") <|> absolutePath
+  namesOnly = Set.fromList <$> list text
+  dynamicOutputs = namesOnly <|> do
+    _ <- char '('
+    names <- namesOnly <* char ','
+    children <- list (pair text dynamicOutputs)
+    _ <- char ')'
+    pure $ names <> Set.fromList (fst <$> children)
