+/// Tie each dialog's answer to its own request; a late click must not accept
+/// the next sender's offer. Leave time before Owly's 15-second request deadline.
+async fn confirm_offer(program: &std::path::Path, message: &str) -> bool {
+    let mut command = tokio::process::Command::new(program);
+    command
+        .arg(message)
+        .stdin(std::process::Stdio::null())
+        .kill_on_drop(true);
+    matches!(
+        tokio::time::timeout(Duration::from_secs(12), command.status()).await,
+        Ok(Ok(status)) if status.success()
+    )
+}
